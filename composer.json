{
    "name": "wabuehamm/wabue",
    "description": "Plugin for specific Elgg-modifications for Waldbuehne Heessen",
    "type": "elgg-plugin",
    "keywords": [
        "elgg",
        "plugin"
    ],
    "license": "MIT",
    "support": {
        "source": "https://github.com/wabuehamm/elgg-plugin-wabue",
        "issues": "https://github.com/wabuehamm/elgg-plugin-wabue/issues"
    },
    "require": {
        "composer/installers": "^1.0.8",
        "phpoffice/phpspreadsheet": "^5.3.0",
        "kigkonsult/icalcreator": "^2.41"
    },
    "require-dev": {
        "elgg/sniffs": "dev-master",
        "squizlabs/php_codesniffer": "3.*"
    },
    "conflict": {
        "elgg/elgg": "<3.0.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
